{
  "name": "spend-app",
  "version": "0.10.0",
  "private": true,
  "description": "Personal budget and spending desktop app",
  "author": "Spend contributors",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "build:electron": "tsc -p tsconfig.main.json && node scripts/write-electron-src-package.mjs && tsc -p tsconfig.preload.json && node -e \"try { require('fs').unlinkSync('dist-electron/ipc-contract.js'); } catch (_) { /* optional */ }\"",
    "watch:electron": "concurrently \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\"",
    "dev": "npm run build:electron && concurrently -k \"npm run watch:electron\" \"vite\" \"wait-on tcp:127.0.0.1:5173 file:dist-electron/main.js file:dist-electron/preload.js && ELECTRON_IS_DEV=1 electron .\"",
    "dev:electron": "npm run build:electron && wait-on tcp:127.0.0.1:5173 file:dist-electron/main.js file:dist-electron/preload.js && ELECTRON_IS_DEV=1 electron .",
    "electron:only": "npm run build:electron && ELECTRON_IS_DEV=1 electron .",
    "build": "vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "icons:mac": "bash scripts/generate-mac-icon.sh",
    "pack:mac": "node scripts/pack-mac-dir.mjs",
    "pack:mac:arm64": "npm run build && CSC_IDENTITY_AUTO_SELECT=false electron-builder --mac --dir --arm64",
    "pack:mac:arm64:verbose": "npm run build && DEBUG=electron-builder* CSC_IDENTITY_AUTO_SELECT=false electron-builder --mac --dir --arm64",
    "pack:mac:x64": "npm run build && CSC_IDENTITY_AUTO_SELECT=false electron-builder --mac --dir --x64",
    "dist:mac": "npm run build && bash scripts/dist-mac-signed.sh",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:import": "tsx --test tests/csv-import.test.ts",
    "test:dedupe": "tsx --test tests/dedupe.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "postinstall": "electron-rebuild -f -w better-sqlite3 --arch $(node scripts/electron-native-arch.mjs)",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3 --arch $(node scripts/electron-native-arch.mjs)"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "csv-parse": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "afterPack": "scripts/electron-after-pack.cjs",
    "appId": "com.nicocrisafulli.spend",
    "productName": "Spend",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "database/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**"
    ],
    "compression": "store",
    "dmg": {
      "sign": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "NICHOLAS FREEDOM CRISAFULLI (KB8N3Q3ZAF)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "buildResources/entitlements.mac.plist",
      "entitlementsInherit": "buildResources/entitlements.mac.plist",
      "notarize": true
    }
  }
}
